	{
		"name": "LeBooBoo",
		"avatar": "",
		"lines": [
			{
				"voice": "50_02",
				"text": "Awesome job cowbell guy. You got a Patreon I could subscribe to or something?"
			}
		]
	},
	{
		"name": "Command",
		"command": "a"
	},
	{
		"name": "AgentForty",
		"avatar": "",
		"lines": [
			{
				"voice": "50_03",
				"text": "I’m afraid I… don’t know how all that works."
			}
		]
	},
	{
		"name": "MoneyPony",
		"avatar": "",
		"lines": [
			{
				"voice": "50_04",
				"text": "Head to extraction Forty. I’ve hacked ads into LeBooBoo’s premium feed. I think that’s the last we’ll be hearing from him..."
			}
		]
	},
	{
		"name": "Command",
		"command": "b"
	},
	{
		"name": "LeBooBoo",
		"avatar": "",
		"lines": [
