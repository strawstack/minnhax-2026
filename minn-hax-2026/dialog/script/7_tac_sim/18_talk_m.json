	{
		"name": "Command",
		"command": "camera3D_M"
	},
	{
		"name": "M",
		"avatar": "",
		"lines": [
			{
				"voice": "18_03",
				"text": "The agency has a new quantum super computer. It came up with the logo. Two i’s for Minnesota. We’re based there now."
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_Agent"
	},
	{
		"name": "AgentForty",
		"avatar": "",
		"lines": [
			{
				"voice": "18_04",
				"text": "I don’t think that’s how you spell -"
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_GreenDay"
	},
	{
		"name": "GreenDay",
		"avatar": "",
		"lines": [
			{
				"voice": "18_05",
				"text": "You’re late."
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_Agent"
	},
	{
		"name": "AgentForty",
		"avatar": "",
		"lines": [
			{
				"voice": "18_06",
				"text": "You’re… in a body cast?!"
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_GreenDay"
	},
	{
		"name": "GreenDay",
		"avatar": "",
		"lines": [
			{
				"voice": "18_07",
				"text": "009 manipulated me. He’s a master manipulator. One time, he told me to go to a chess tournament, and, when I least expected it, he blew it up."
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_Agent"
	},
	{
		"name": "AgentForty",
		"avatar": "",
		"lines": [
			{
				"voice": "18_08",
				"text": "Manipulated? That sounds more like straightforward terrorism?"
			}
		]
	},
	{
		"name": "Command",
		"command": "camera3D_GreenDay"
	},
	{
		"name": "GreenDay",
		"avatar": "",
		"lines": [
			{
				"voice": "18_09",
				"text": "No, he manipulated me into the building. You don’t understand. He’s a master. Anyways, the building bomb was a different thing. I was completely unharmed. I’m afraid the reason I’m in a body cast is yassified."
			}
		]
	},
	{
		"name": "AgentForty",
		"avatar": "",
		"lines": [
			{
				"voice": "18_10",
				"text": "Classified?"
			}
		]
	},
	{
		"name": "GreenDay",
		"avatar": "",
		"lines": [
			{
				"voice": "18_11",
				"text": "No, yassified. 009 told me to meet him on a bridge, and we’d go get yassified. He knew I couldn’t resist."
			}
		]
	},
	{
		"name": "Command",
		"command": "mSidewaysGlance"
	},
